{
  "schema": "haven-gate-config/1",
  "engine": {
    "repo": "https://github.com/NguyenTrongPhuc552003/haven.git",
    "commit": "299566ed6d7a63593ebf71bfe17f9d664e01df9d"
  },
  "go_paths": [
    "cmd",
    "core",
    "sdk",
    "assets"
  ],
  "c_paths": [
    "examples"
  ],
  "c_include": [],
  "exclude": [],
  "scan_exclude": [],
  "jscpd_formats": "go,c",
  "jscpd_ignore": [
    "**/*_test.go"
  ],
  "limits": {
    "ccn": 15,
    "length": 100,
    "dup_lines": 15
  },
  "tool_dirs": [
    "/opt/homebrew/bin",
    "~/go/bin",
    "~/.local/bin"
  ],
  "golangci": {
    "linters": [
      "govet",
      "staticcheck",
      "errcheck",
      "ineffassign",
      "unused"
    ]
  },
  "stages": {
    "pre-commit": [
      "scan"
    ],
    "pre-push": [
      "scan",
      "gofmt",
      "golangci-lint",
      "cppcheck",
      "lizard",
      "jscpd",
      "shellcheck"
    ],
    "ci": [
      "scan",
      "gitleaks",
      "gofmt",
      "golangci-lint",
      "govulncheck",
      "cppcheck",
      "lizard",
      "jscpd",
      "shellcheck",
      "copies"
    ],
    "deep": [
      "scan",
      "gitleaks",
      "gofmt",
      "golangci-lint",
      "govulncheck",
      "cppcheck",
      "lizard",
      "jscpd",
      "shellcheck",
      "go-race",
      "go-fuzz"
    ]
  },
  "versions": {
    "go": "1.27.4",
    "golangci-lint": "2.15.0",
    "govulncheck": "1.9.0",
    "cppcheck": "2.22.0",
    "lizard": "1.26.0",
    "jscpd": "5.4.3",
    "gitleaks": "8.30.1",
    "shellcheck": "0.11.0"
  },
  "sh_paths": [
    ".githooks"
  ],
  "sh_files": [
    ".githooks/pre-commit",
    ".githooks/pre-push"
  ],
  "fuzz": {
    "seconds": 60,
    "targets": [
      {
        "name": "FuzzUntar",
        "package": "./core/domain/demo"
      },
      {
        "name": "FuzzParseSums",
        "package": "./core/domain/demo"
      }
    ]
  },
  "copies": {
    "scripts/gate": "repo-gate.sh",
    ".githooks/pre-commit": "pre-commit",
    ".githooks/pre-push": "pre-push"
  }
}
