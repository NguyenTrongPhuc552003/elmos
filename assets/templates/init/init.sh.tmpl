#!/bin/sh
# elmos /init for QEMU guests. Embedded in the elmos binary and written into
# every root filesystem that 'elmos rootfs create' makes (both engines).

echo "Booting elmos root filesystem..."

# Mount essential virtual filesystems first: the debootstrap second stage
# and the tools below need them.
mount -t proc  proc  /proc
mount -t sysfs sys   /sys
mount -t devtmpfs dev /dev 2>/dev/null || mount -t tmpfs dev /dev
[ -d /dev/pts ] || mkdir /dev/pts
mount -t devpts devpts /dev/pts

# debootstrap engine: finish the foreign install on first boot.
MARKER="/.rootfs-setup-complete"
if [ -x /debootstrap/debootstrap ] && [ ! -f "$MARKER" ]; then
    echo "First boot: running debootstrap second stage..."
    if /debootstrap/debootstrap --second-stage; then
        touch "$MARKER"
        echo "Second stage completed."
    else
        echo "Second stage failed, dropping to a shell."
        [ -f /debootstrap/debootstrap.log ] && cat /debootstrap/debootstrap.log
        exec /bin/sh
    fi
fi

# Network for QEMU user-mode networking, when iproute2 is installed
# (container base images such as debian:stable-slim do not ship it).
if command -v ip >/dev/null 2>&1; then
    ip link set lo up
    ip link set eth0 up
    ip addr add 10.0.2.15/24 dev eth0
    ip route add default via 10.0.2.2
    echo "nameserver 10.0.2.3" > /etc/resolv.conf
else
    echo "No 'ip' command: network not configured."
fi

# Shared folder from the host (modules built by 'elmos module build').
mkdir -p /mnt/modules
if mount -t 9p -o trans=virtio,version=9p2000.L modules_mount /mnt/modules 2>/dev/null; then
    if [ -x /mnt/modules/guesync.sh ]; then
        echo "Running guest module synchronization script..."
        /mnt/modules/guesync.sh
    fi
else
    echo "No host share mounted at /mnt/modules."
fi

echo "System ready."

# Automated boots (the SDK smoke boot, docs/developer/sdk-ci.md): with
# elmos_poweroff=1 on the kernel command line, which the kernel passes to
# init's environment, power off instead of starting a shell.
if [ "${elmos_poweroff:-}" = 1 ]; then
    echo "elmos: elmos_poweroff=1, powering off."
    sync
    poweroff -f 2>/dev/null || echo o > /proc/sysrq-trigger
fi

exec /bin/sh
